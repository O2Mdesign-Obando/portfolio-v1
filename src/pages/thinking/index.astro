---
import MainLayout from "../../layouts/MainLayout.astro";

const portfolioArticles = [
  {
    title: "Designing Through Change",
    href: "/thinking/designing-through-change",
    description:
      "The evolution of digital design—from pages to platforms to intelligent systems—and how it changes how we build products.",
  },
  {
    title: "Measuring What Matters",
    href: "/thinking/measuring-what-matters",
    description:
      "Why design must connect directly to business KPIs—and how to turn design decisions into measurable impact.",
  },
  {
    title: "Governed Product System",
    href: "/thinking/governed-product-system",
    description:
      "Why real product systems require governance, observability, and discipline—and how to design for evolution without drift.",
  },
];

const o2mArticles = [
  {
    title: "When Technology Learns How We Work",
    date: "July 9, 2026",
    category: "Human Capability",
    summary:
      "Why adaptation should move in both directions.",
    description:
      "The next generation of intelligent systems may become valuable not only because they know more, but because they learn how to work with people more naturally over time.",
    href: "https://www.o2mdesign.com/thinking/when-technology-learns-how-we-work",
  },
  {
    title: "Technology Has Always Been About Us",
    date: "July 2, 2026",
    category: "Human Capability",
    summary:
      "Why remaining capable may matter more than keeping up.",
    description:
      "A reflection on technology as the extension of human capability, and why the deeper question around AI is not only what intelligent systems can do, but whether people continue becoming more capable alongside them.",
    href: "https://www.o2mdesign.com/thinking/technology-has-always-been-about-us",
  },
  {
    title: "Resumption Is the New Productivity",
    date: "June 25, 2026",
    category: "Continuity Infrastructure",
    summary:
      "Why continuing the work may matter more than starting it.",
    description:
      "Modern tools make it easier than ever to start work. The harder challenge is helping people return to work with enough context to continue meaningfully.",
    href: "https://www.o2mdesign.com/thinking/resumption-is-the-new-productivity",
  },
  {
    title: "The Problem With Systems That Forget",
    date: "June 11, 2026",
    category: "Continuity & Context",
    summary:
      "Why the next layer of productivity depends on preserving context, not just generating output.",
    description:
      "Modern systems are increasingly good at preserving information, but much weaker at preserving the context, reasoning, decisions, and continuity that allow meaningful work to continue.",
    href: "https://www.o2mdesign.com/thinking/the-problem-with-systems-that-forget",
  },
  {
    title: "Why Knowledge Work Feels Increasingly Fragmented",
    date: "May 28, 2026",
    category: "Continuity & Context",
    summary:
      "The problem is not that we lack information. It is that modern work no longer preserves the thread between tools, decisions, and context.",
    description:
      "Modern work increasingly happens across disconnected tools, conversations, automations, and AI systems. The challenge is no longer producing information; it is preserving continuity across it.",
    href: "https://www.o2mdesign.com/thinking/why-knowledge-work-feels-increasingly-fragmented",
  },
  {
    title: "Continuity Infrastructure",
    date: "May 19, 2026",
    category: "Systems Thinking",
    summary:
      "Why some digital systems need to preserve context before they try to accelerate output.",
    description:
      "A short observation on the difference between engagement infrastructure and continuity infrastructure, and why that distinction matters for complex digital work.",
    href: "https://www.o2mdesign.com/thinking/continuity-infrastructure",
  },
];
---

<MainLayout
  title="Thinking | Jorge Obando"
  description="Thinking by Jorge Obando on systems design, enterprise product strategy, AI integration, governance, and measurable business impact."
>
  <section class="thinking-page">
    <section class="hero">
      <p class="eyebrow">Thinking</p>
      <h1>Perspectives on systems, product, and AI</h1>
      <p class="lead">
        Writing that explores how complex systems are designed, scaled, and governed—
        across enterprise platforms, AI, and product ecosystems.
      </p>

      <p class="hero-links">
        <a href="/case-studies">See related case studies</a>
        <a href="/narrative">See how I operate</a>
      </p>
    </section>

    <section class="articles" aria-label="Thinking articles">
      {portfolioArticles.map((article) => (
        <article class="article-card">
          <a href={article.href}>
            <h2>{article.title}</h2>
            <p>{article.description}</p>
          </a>
        </article>
      ))}
    </section>

    <section class="articles-section" aria-labelledby="latest-writing-title">
      <p class="section-label">Latest writing from O2M Design</p>
      <h2 id="latest-writing-title">Proof of reasoning</h2>

      <div class="articles" aria-label="O2M thinking articles">
      {o2mArticles.map((article) => (
        <article class="article-card">
          <a href={article.href} target="_blank" rel="noopener noreferrer">
            <p class="article-meta">{article.date} · {article.category}</p>
            <h2>{article.title}</h2>
            <p class="article-summary">{article.summary}</p>
            <p>{article.description}</p>
            <span class="article-link">Read on O2M Design →</span>
          </a>
        </article>
      ))}
      </div>
    </section>
    
    <p class="archive-link">
      <a href="https://www.o2mdesign.com/thinking" target="_blank" rel="noopener noreferrer">
        Explore the full thinking archive on O2M Design →
      </a>
    </p>
  </section>
</MainLayout>

<style>
  .thinking-page {
    padding: 2.5rem 0 5rem;
  }

  .hero {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a33a3a;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.5rem, 4vw, 4.15rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .lead {
    margin-top: 1.2rem;
    font-size: 1.1rem;
    line-height: 1.85;
    color: #555;
    max-width: 760px;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin: 1.2rem 0 0;
  }

  .hero-links a {
    font-size: 0.95rem;
    font-weight: 600;
    color: #111;
    text-decoration: none;
  }

  .articles {
    display: grid;
    gap: 1.25rem;
  }

  .articles-section {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--divider);
  }

  .section-label {
    margin: 0 0 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a33a3a;
  }

  .articles-section > h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.8rem, 2.2vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .article-card {
    border: 1px solid var(--divider);
    border-radius: 16px;
    background: #fff;
    padding: 1.5rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .article-card a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .article-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
  }

  .article-card h2 {
    margin: 0 0 0.6rem;
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .article-card p {
    margin: 0;
    color: #555;
    line-height: 1.7;
    max-width: 720px;
  }

  .article-meta {
    margin-bottom: 0.65rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #777;
  }

  .article-card .article-summary {
    margin-bottom: 0.7rem;
    color: #222;
    font-weight: 600;
  }

  .article-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.95rem;
    color: #a33a3a;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .thinking-page {
      padding: 1.5rem 0 4rem;
    }

    .lead {
      font-size: 1.02rem;
      line-height: 1.8;
    }

    .hero-links {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
    .archive-link {
    margin-top: 2rem;
  }

  .archive-link a {
    font-size: 0.95rem;
    font-weight: 600;
    color: #111;
    text-decoration: none;
  }

  .archive-link a:hover {
    text-decoration: underline;
  }
</style>
